    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-text-muted">
      <p>&copy; {year} Audrey Evergreene. All rights reserved.</p>
      <nav class="flex items-center gap-4">
        <a href="https://ladyaudrey.github.io/Forest/" target="_blank" rel="noopener noreferrer" class="hover:text-text transition-colors duration-300">
          Forest
        </a>
        <span class="text-border">|</span>
        <a href="/" class="hover:text-text transition-colors duration-300">
          Studio
        </a>
      </nav>
      <p>Built with care</p>
    </div>
  </div>
</footer>
