---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-border mt-auto">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-text-muted">
      <p>&copy; {year} Audrey Evergreene. All rights reserved.</p>
      <nav class="flex items-center gap-4">
        <a href={base} class="hover:text-text transition-colors duration-300">
          AnEvergreene Studio
        </a>
      </nav>
      <p>Built with care</p>
    </div>
  </div>
</footer>
