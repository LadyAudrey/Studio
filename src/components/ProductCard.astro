---
interface Props {
  title: string;
  description?: string;
  href: string;
  logo?: string;
  status: 'coming-soon' | 'beta' | 'live' | 'sunset';
  pricing?: string;
}

const { title, description, href, logo, status, pricing } = Astro.props;

const statusStyles: Record<string, string> = {
  'coming-soon': 'bg-bg-muted text-text-muted',
  'beta': 'bg-copper-100 text-copper-800 dark:bg-tag-bg dark:text-tag-text',
  'live': 'bg-sand-100 text-sand-800 dark:bg-navy-800 dark:text-sand-300',
  'sunset': 'bg-warmgray-100 text-warmgray-700 dark:bg-navy-800 dark:text-warmgray-400',
};

const statusLabels: Record<string, string> = {
  'coming-soon': 'Coming Soon',
  'beta': 'Beta',
  'live': 'Live',
  'sunset': 'Sunset',
};
---

<a href={href} class="group block p-6 rounded-xl border border-border hover:border-accent bg-surface transition-all duration-300">
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1">
      {logo && <img src={logo} alt="" class="w-10 h-10 rounded-lg mb-3" />}
      <h3 class="text-xl font-heading font-semibold group-hover:text-accent transition-colors duration-300">
        {title}
      </h3>
      {description && (
        <p class="mt-2 text-sm text-text-secondary line-clamp-3">
          {description}
        </p>
      )}
    </div>
    <span class={`text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap ${statusStyles[status]}`}>
      {statusLabels[status]}
    </span>
  </div>
  {pricing && (
    <p class="mt-4 text-xs text-text-muted uppercase tracking-wide">{pricing}</p>
  )}
</a>
