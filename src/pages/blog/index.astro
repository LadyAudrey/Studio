---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.published !== false))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog — AnEvergreene Studio" description="Thoughts on building calm tech, running a studio, and making things that matter.">
  <h1 class="text-4xl font-heading font-bold mb-4">Blog</h1>
  <p class="text-text-secondary mb-10 max-w-2xl">
    Thoughts on building calm tech, running a studio, and making things that matter.
  </p>

  {posts.length > 0 ? (
    <div class="grid gap-6 sm:grid-cols-2">
      {posts.map((post) => (
        <ContentCard
          title={post.data.title}
          description={post.data.description}
          href={`/blog/${post.slug}/`}
          date={post.data.date}
          tags={post.data.tags}
        />
      ))}
    </div>
  ) : (
    <p class="text-text-muted">No posts yet — stay tuned.</p>
  )}
</BaseLayout>
