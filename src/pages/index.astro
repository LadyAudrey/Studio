---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ContentCard from '../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products', ({ data }) => data.published && data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const recentPosts = (await getCollection('blog', ({ data }) => data.published !== false))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="AnEvergreene Studio">
  <!-- Hero -->
  <section class="py-16 sm:py-24 max-w-2xl">
    <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-semibold leading-tight">
      Calm tech, tailored to<br />
      <span class="italic text-accent">your nervous system.</span>
    </h1>
    <p class="mt-6 text-xl text-text-secondary leading-relaxed max-w-lg">
      Not a box someone else designed — a home that grows with you.
    </p>
    <p class="mt-4 text-sm text-text-muted max-w-lg">
      I've been the person drowning in platforms that don't fit. Now I create the alternative.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/services/" class="px-6 py-3 bg-accent text-bg rounded-lg font-medium hover:opacity-90 transition-opacity duration-300">
        Need a website?
      </a>
      <a href="https://ladyaudrey.github.io/Forest/" target="_blank" rel="noopener noreferrer" class="px-6 py-3 border border-accent text-accent rounded-lg font-medium hover:bg-accent hover:text-bg transition-all duration-300">
        See my work
      </a>
    </div>
  </section>

  <!-- Featured Products -->
  {products.length > 0 && (
    <section class="py-12">
      <h2 class="text-2xl font-heading font-semibold mb-2">Things I'm making</h2>
      <p class="text-text-muted mb-8">Tools that start with how someone feels, then work backwards to the code.</p>
      <div class="grid gap-6 sm:grid-cols-2">
        {products.map((product) => (
          <ProductCard
            title={product.data.title}
            description={product.data.description}
            href={`/products/${product.slug}/`}
            logo={product.data.logo}
            status={product.data.status}
            pricing={product.data.pricing}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Recent Blog Posts -->
  {recentPosts.length > 0 && (
    <section class="py-12">
      <!-- TODO: Restore "All posts →" link once there are 2+ blog posts -->
      <h2 class="text-2xl font-heading font-semibold mb-8">Latest thoughts</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {recentPosts.map((post) => (
          <ContentCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.slug}/`}
            date={post.data.date}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
