---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ContentCard from '../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products', ({ data }) => data.published && data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const recentPosts = (await getCollection('blog', ({ data }) => data.published !== false))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="AnEvergreene Studio">
  <!-- Hero -->
  <section class="py-16 sm:py-24 max-w-2xl">
    <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-semibold leading-tight">
      Tech that doesn't<br />
      <span class="italic text-accent">overwhelm.</span>
    </h1>
    <p class="mt-6 text-lg text-text-secondary leading-relaxed max-w-lg">
      I build websites and tools for people who care about how things feel — not just how they look. Calm by default. Personal by design.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/products/" class="px-6 py-3 bg-accent text-bg rounded-lg font-medium hover:opacity-90 transition-opacity duration-300">
        What I'm building
      </a>
      <a href="/services/" class="px-6 py-3 border border-accent text-accent rounded-lg font-medium hover:bg-accent hover:text-bg transition-all duration-300">
        Need a website?
      </a>
    </div>
  </section>

  <!-- Featured Products -->
  {products.length > 0 && (
    <section class="py-12">
      <h2 class="text-2xl font-heading font-semibold mb-2">Things I'm making</h2>
      <p class="text-text-muted mb-8">Tools that start with how someone feels, then work backwards to the code.</p>
      <div class="grid gap-6 sm:grid-cols-2">
        {products.map((product) => (
          <ProductCard
            title={product.data.title}
            description={product.data.description}
            href={`/products/${product.slug}/`}
            logo={product.data.logo}
            status={product.data.status}
            pricing={product.data.pricing}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Services callout -->
  <section class="py-12">
    <div class="rounded-xl border border-border bg-surface p-8 sm:p-12">
      <h2 class="text-2xl font-heading font-semibold">You shouldn't need to learn code to have a home online.</h2>
      <p class="mt-3 text-text-secondary max-w-xl">
        I set up personal websites for people who'd rather focus on their work. You tell me what matters to you — I make it real. Setup, hosting, updates, all of it.
      </p>
      <a href="/services/" class="mt-6 inline-block px-6 py-3 border border-accent text-accent rounded-lg font-medium hover:bg-accent hover:text-bg transition-all duration-300">
        How it works &rarr;
      </a>
    </div>
  </section>

  <!-- Recent Blog Posts -->
  {recentPosts.length > 0 && (
    <section class="py-12">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-heading font-semibold">Latest thoughts</h2>
        <a href="/blog/" class="text-sm text-accent hover:text-accent-hover transition-colors duration-300">
          All posts &rarr;
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {recentPosts.map((post) => (
          <ContentCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.slug}/`}
            date={post.data.date}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
