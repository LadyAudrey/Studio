---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — AnEvergreene Studio" description="Get in touch with AnEvergreene Studio.">
  <h1 class="text-4xl font-heading font-bold mb-4">Contact</h1>
  <p class="text-text-secondary mb-10 max-w-2xl">
    Whether you're interested in a service, want to collaborate, or just want to say hello — here's how to reach Audrey.
  </p>

  <div class="grid gap-8 sm:grid-cols-2 max-w-2xl">
    <div class="rounded-xl border border-border bg-surface p-6">
      <h2 class="text-lg font-heading font-semibold mb-3">Email</h2>
      <p class="text-text-secondary text-sm">
        The best way to reach me for services or collaboration.
      </p>
      <p class="mt-3 text-accent">
        <!-- Replace with your actual email -->
        hello@audreyevergreene.me
      </p>
    </div>

    <div class="rounded-xl border border-border bg-surface p-6">
      <h2 class="text-lg font-heading font-semibold mb-3">Newsletter</h2>
      <p class="text-text-secondary text-sm">
        Updates on new products, behind-the-scenes process, and creative writing.
      </p>
      <a href="https://audreys-evergreene-newsletter.beehiiv.com/"
        target="_blank" rel="noopener noreferrer"
        class="mt-3 inline-block text-accent hover:text-accent-hover transition-colors duration-300">
        Subscribe on Beehiiv &rarr;
      </a>
    </div>

    <div class="rounded-xl border border-border bg-surface p-6">
      <h2 class="text-lg font-heading font-semibold mb-3">GitHub</h2>
      <p class="text-text-secondary text-sm">
        Open source projects and contributions.
      </p>
      <a href="https://github.com/LadyAudrey"
        target="_blank" rel="noopener noreferrer"
        class="mt-3 inline-block text-accent hover:text-accent-hover transition-colors duration-300">
        @LadyAudrey &rarr;
      </a>
    </div>

    <div class="rounded-xl border border-border bg-surface p-6">
      <h2 class="text-lg font-heading font-semibold mb-3">Creative work</h2>
      <p class="text-text-secondary text-sm">
        Stories, poetry, and art live over in the Forest.
      </p>
      <a href="https://ladyaudrey.github.io/Forest/"
        target="_blank" rel="noopener noreferrer"
        class="mt-3 inline-block text-accent hover:text-accent-hover transition-colors duration-300">
        Visit Forest &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
