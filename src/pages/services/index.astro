---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceTier from '../../components/ServiceTier.astro';
import { getCollection } from 'astro:content';

const allServices = (await getCollection('services', ({ data }) => data.published !== false))
  .sort((a, b) => a.data.order - b.data.order);

const websiteServices = allServices.filter(s => s.data.tier === 'starter' || s.data.tier === 'growth');
const otherServices = allServices.filter(s => s.data.tier !== 'starter' && s.data.tier !== 'growth');
---

<BaseLayout title="Services — AnEvergreene Studio" description="Get a beautiful personal website without touching code.">
  <h1 class="text-4xl font-heading font-bold mb-4">Your site, without the stress.</h1>
  <p class="text-text-secondary mb-10 max-w-2xl">
    You have things to share with the world. I'll handle the tech so you can focus on what actually matters to you.
  </p>

  <div class="grid gap-8 lg:grid-cols-2 mb-8">
    {websiteServices.map((service, i) => (
      <ServiceTier
        title={service.data.title}
        description={service.data.description}
        price={service.data.price}
        features={service.data.features}
        cta_text={service.data.cta_text}
        cta_url={service.data.cta_url}
        highlighted={i === 0}
      />
    ))}
  </div>

  {otherServices.length > 0 && (
    <div class="mb-16 space-y-8">
      {otherServices.map((service) => (
        <ServiceTier
          title={service.data.title}
          description={service.data.description}
          price={service.data.price}
          features={service.data.features}
          cta_text={service.data.cta_text}
          cta_url={service.data.cta_url}
          wide={true}
          example_url={service.slug === 'newsletter' ? 'https://anevergreene.beehiiv.com' : undefined}
          example_label={service.slug === 'newsletter' ? 'See my newsletter' : undefined}
        />
      ))}
    </div>
  )}

  <section class="rounded-xl border border-border bg-surface p-8 sm:p-12 text-center">
    <h2 class="text-2xl font-heading font-semibold">Something else in mind?</h2>
    <p class="mt-3 text-text-secondary max-w-xl">
      Every project is different. If these don't quite fit, let's talk — I'd rather build something that actually works for you than squeeze you into a box.
    </p>
    <a href={`${import.meta.env.BASE_URL}contact/`} class="mt-6 inline-block px-6 py-3 border border-accent text-accent rounded-lg font-medium hover:bg-accent hover:text-bg transition-all duration-300">
      Reach out &rarr;
    </a>
  </section>
</BaseLayout>
